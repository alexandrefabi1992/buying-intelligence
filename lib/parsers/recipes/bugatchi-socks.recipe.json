{
  "version": 1,
  "meta": {
    "supplier_key": "bugatchi-socks",
    "target_manufacturer": "Bugatchi",
    "default_vendor_id": "",
    "default_attribute_set_id": "7",
    "notes": "Bugatchi Fashion Mercerized Socks — multi-line block format, one PO per file, One-Size only."
  },
  "detection": {
    "match_all": ["Bugatchi", "Order#:", "FASHION"],
    "match_any": ["MERCERIZED SOCKS", "spring / summer"]
  },
  "extraction": {
    "engine": "coordinate",
    "tolerances": { "y_pt": 3, "x_pt": 8 },
    "parser": null,

    "file_fields": {},

    "orders": {
      "fields": {
        "po_number": {
          "regex": "Order#:\\s*(\\d+)",
          "group": 1
        },
        "customer_reference": {
          "regex": "PO\\s*#:\\s*([^\\n]+?)\\s*$",
          "group": 1,
          "transform": "trim"
        },
        "delivery_date": {
          "regex": "Delivery:\\s*(\\d{2}/\\d{2}/\\d{4})",
          "group": 1,
          "transform": "date_mdy_to_iso"
        },
        "cancel_date": {
          "regex": "Delivery:\\s*\\d{2}/\\d{2}/\\d{4}\\s*-\\s*(\\d{2}/\\d{2}/\\d{4})",
          "group": 1,
          "transform": "date_mdy_to_iso"
        }
      },

      "declared_totals_extraction": {
        "regex": "Total Units:\\s*(\\d+)[\\s\\S]*?Total Price:\\s*CA\\$([\\d,]+\\.\\d{2})",
        "flags": "i",
        "units_group": 1,
        "amount_group": 2
      }
    },

    "products": {
      "layout_type": "flat_table",

      "row_header": {
        "regex": "^(FASHION\\s+[A-Z ]+SOCKS)\\s+CA\\$([\\d.]+)\\s+(\\d+)\\s+CA\\$([\\d.]+)\\s*$",
        "fields": {
          "description": { "group": 1, "transform": "trim" }
        },
        "trailing_metrics": {
          "regex": "CA\\$([\\d.]+)\\s+(\\d+)\\s+CA\\$([\\d.]+)\\s*$",
          "fields": {
            "unit_cost":           { "group": 1, "transform": "decimal" },
            "total_qty_declared":  { "group": 2, "transform": "int" },
            "line_total_declared": { "group": 3, "transform": "decimal" }
          }
        }
      },

      "subsequent_lines": [
        {
          "offset": 2,
          "regex":  "Style\\s*#:\\s*(\\S+)",
          "fields": { "style_ref": { "group": 1 } }
        },
        {
          "offset": 3,
          "regex":  "Color:\\s*(.+?)\\s*$",
          "fields": { "color_label": { "group": 1, "transform": "trim" } }
        }
      ],

      "variants": {
        "line_offset":              4,
        "extract_from_line_regex":  "Sizes:\\s*(.+?)\\s*$",
        "extract_from_line_group":  1,
        "pattern":                  "([A-Z]+|\\d{1,3}):\\s*(\\d+)",
        "size_group":               1,
        "qty_group":                2
      }
    }
  }
}
